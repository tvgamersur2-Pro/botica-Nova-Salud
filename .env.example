# ============================================================
# Nova Salud - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------------
# Application
# ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ----------------------------------------------------------------
# MySQL
# ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nova_salud
DB_USER=root
DB_PASSWORD=your_strong_password_here

# Connection pool settings
DB_POOL_MAX=20
DB_CONN_TIMEOUT=5000

# ----------------------------------------------------------------
# Redis (session store & cache)
# ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ----------------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------------
# Security
# ----------------------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------
# Email (for alert notifications)
# ----------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@novasalud.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=Nova Salud <notifications@novasalud.com>

# ----------------------------------------------------------------
# AWS (backups & file storage)
# ----------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BACKUP_BUCKET=nova-salud-backups

# ----------------------------------------------------------------
# Payment Gateway (Stripe example)
# ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
