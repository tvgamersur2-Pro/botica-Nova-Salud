{
  "name": "nova-salud-backend",
  "version": "1.0.0",
  "description": "Nova Salud - Pharmacy Inventory and Sales Management System (Backend)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:migrate:dev": "ts-node src/scripts/migrate.ts"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "9.0.2",
    "mysql2": "3.9.7",
    "node-cron": "3.0.3",
    "winston": "3.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.41",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "eslint": "8.57.0",
    "fast-check": "3.20.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
